GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=sqlite:///./data/agentops.db
LLM_PROVIDER=mock
EXTERNAL_API_ENABLED=false
REAL_VALIDATION_ENABLED=false
WORKSPACE_LIVE_ENABLED=false
PAID_OPERATIONS_ENABLED=false
# Optional price estimates, USD per million tokens. Blank means unknown.
# INPUT_PRICE_PER_MILLION=0.30
# OUTPUT_PRICE_PER_MILLION=2.50

# v0.3: only the bundled read-only MCP server; no arbitrary commands/endpoints.
LOCAL_MCP_ENABLED=true
# Exact HTTPS URL list. Public DNS only; redirects must also be listed.
HTTP_FETCH_ALLOWED_URLS=["https://example.com/"]
APPROVAL_TIMEOUT_SECONDS=60

# v0.5: offline by default. Google requires explicit document consent as well.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_REQUESTS=32
EMBEDDING_EXTERNAL_ENABLED=false
